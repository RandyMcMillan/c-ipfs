{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "c-ipfs <-> Kubo Interoperability Vector Manifest",
  "version": "1.0.0",
  "kubo_target_version": "v0.43.0",
  "vectors": [
    {
      "id": "VECTOR-001",
      "name": "raw_block_bitswap_exchange",
      "description": "Verify raw block exchange between c-ipfs and Kubo v0.43.0 via Bitswap",
      "direction": "bidirectional",
      "payload": {
        "type": "raw",
        "size_bytes": 1024,
        "content_pattern": "repeat_bytes_0x42"
      },
      "expected": {
        "cid_version": 1,
        "codec": "raw",
        "multihash": "sha2-256"
      }
    },
    {
      "id": "VECTOR-002",
      "name": "unixfs_file_transfer_v0_v1",
      "description": "Transfer UnixFS DAGs (CIDv0 & CIDv1) generated by c-ipfs to Kubo and verify hash equality",
      "direction": "c-ipfs-to-kubo",
      "payload": {
        "type": "unixfs",
        "structure": "nested_directory",
        "files": [
          {
            "path": "file1.txt",
            "size": 65536
          },
          {
            "path": "dir/file2.txt",
            "size": 1048576
          }
        ]
      },
      "expected": {
        "hash_match": true,
        "tree_recursive_cat": true
      }
    },
    {
      "id": "VECTOR-003",
      "name": "dag_cbor_traversal",
      "description": "Encode DAG-CBOR in c-ipfs, retrieve and traverse via Kubo v0.43.0 dag get",
      "direction": "c-ipfs-to-kubo",
      "payload": {
        "type": "dag-cbor",
        "structure": {
          "name": "c-ipfs-interop",
          "version": "0.1.0",
          "active": true,
          "links": []
        }
      },
      "expected": {
        "codec": "dag-cbor",
        "field_match": true
      }
    },
    {
      "id": "VECTOR-004",
      "name": "ipns_record_publishing_and_resolution",
      "description": "Publish IPNS record via c-ipfs key, resolve and verify updated path via Kubo v0.43.0 name resolve",
      "direction": "c-ipfs-to-kubo",
      "payload": {
        "type": "ipns_entry",
        "key_type": "ed25519",
        "ttl_seconds": 3600
      },
      "expected": {
        "resolved_path_match": true,
        "signature_valid": true
      }
    },
    {
      "id": "VECTOR-005",
      "name": "pubsub_floodsub_gossipsub_relay",
      "description": "Subscribe to PubSub topic on both nodes and assert bidirectionally relayed messages",
      "direction": "bidirectional",
      "payload": {
        "type": "pubsub_message",
        "topic": "/c-ipfs/interop/1.0.0",
        "message": "ping_from_c_ipfs"
      },
      "expected": {
        "message_received": true,
        "topic_match": true
      }
    }
  ]
}
